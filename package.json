{
    "name": "marketplace-api",
    "version": "1.0.0",
    "description": "Marketplace API - course project",
    "main": "dist/main.js",
    "scripts": {
        "setup:secrets": "bash scripts/setup-secrets.sh",
        "gen:types": "openapi-typescript openapi/openapi.yaml -o src/generated/api.ts",
        "build": "npm run gen:types && rm -rf dist && tsc -p tsconfig.build.json",
        "start": "npm run build && node dist/main.js",
        "start:dev": "nest start --watch",
        "typecheck": "npm run gen:types && tsc --noEmit",
        "check:env": "tsx scripts/check-env-example.ts",
        "migrate": "bash scripts/with-secrets.sh dev typeorm migration:run -d dist/database/data-source.js",
        "migrate:show": "bash scripts/with-secrets.sh dev typeorm migration:show -d dist/database/data-source.js",
        "migrate:revert": "bash scripts/with-secrets.sh dev typeorm migration:revert -d dist/database/data-source.js",
        "migrate:generate": "bash scripts/with-secrets.sh dev typeorm migration:generate -d dist/database/data-source.js",
        "seed": "bash scripts/with-secrets.sh dev node dist/database/cli/seed.js",
        "demo:nplus1": "bash scripts/with-secrets.sh dev node dist/database/cli/demo-nplus1.js",
        "demo:race": "bash scripts/with-secrets.sh dev node dist/database/cli/demo-race.js",
        "demo:workers": "bash scripts/with-secrets.sh dev node dist/database/cli/demo-workers.js",
        "demo:retry": "bash scripts/with-secrets.sh dev node dist/database/cli/demo-retry.js",
        "demo:realtime": "node scripts/realtime-demo.mjs",
        "report": "bash scripts/with-secrets.sh dev node dist/database/cli/report.js",
        "test:integration": "jest test/integration",
        "test:e2e": "jest test/e2e",
        "test:contract": "jest test/contract/consumer",
        "verify:provider": "jest test/contract/provider",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "prettier --write \"**/*.{yaml,yml,md}\"",
        "format:check": "prettier --check \"**/*.{yaml,yml,md}\"",
        "lint:api": "redocly lint openapi/openapi.yaml",
        "bundle:api": "redocly bundle openapi/openapi.yaml -o spec.json",
        "check": "npm run typecheck && npm run check:env && npm run lint && npm run format:check && npm run lint:api",
        "prepare": "npm run build"
    },
    "author": "Dmitry Avtenev",
    "license": "ISC",
    "dependencies": {
        "@nestjs/common": "^11.2.3",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.2.3",
        "@nestjs/platform-express": "^11.2.3",
        "@nestjs/platform-socket.io": "^11.2.7",
        "@nestjs/websockets": "^11.2.7",
        "express": "^4.22.2",
        "express-openapi-validator": "^5.6.2",
        "pg": "^8.23.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "socket.io": "^4.8.4",
        "typeorm": "0.3.31",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.10",
        "@nestjs/cli": "^11.0.24",
        "@nestjs/schematics": "^11.1.0",
        "@nestjs/testing": "^11.2.7",
        "@pact-foundation/pact": "^15.0.1",
        "@redocly/cli": "^2.46.0",
        "@testcontainers/postgresql": "^11.14.0",
        "@types/express": "^4.17.25",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.3.0",
        "@types/pg": "^8.23.1",
        "@types/supertest": "^6.0.3",
        "jest": "^30.5.2",
        "openapi-typescript": "^7.13.0",
        "prettier": "^3.9.6",
        "socket.io-client": "^4.8.4",
        "supertest": "^7.3.1",
        "testcontainers": "^11.14.0",
        "ts-jest": "^29.4.14",
        "tsx": "^4.23.12",
        "typescript": "^5.9.3"
    }
}
