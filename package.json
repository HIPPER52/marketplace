{
    "name": "marketplace-api",
    "version": "1.0.0",
    "description": "Marketplace API - course project",
    "main": "dist/main.js",
    "scripts": {
        "setup:secrets": "mkdir -p secrets && printf 'local_dev_password' > secrets/db_password",
        "gen:types": "openapi-typescript openapi/openapi.yaml -o src/generated/api.ts",
        "build": "npm run gen:types && tsc",
        "start": "npm run build && node dist/main.js",
        "start:dev": "nest start --watch",
        "typecheck": "npm run gen:types && tsc --noEmit",
        "check:env": "tsx scripts/check-env-example.ts",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "prettier --write \"**/*.{yaml,yml,md}\"",
        "format:check": "prettier --check \"**/*.{yaml,yml,md}\"",
        "lint:api": "redocly lint openapi/openapi.yaml",
        "bundle:api": "redocly bundle openapi/openapi.yaml -o spec.json",
        "check": "npm run typecheck && npm run check:env && npm run lint && npm run format:check && npm run lint:api",
        "prepare": "npm run build"
    },
    "author": "Dmitry Avtenev",
    "license": "ISC",
    "dependencies": {
        "@nestjs/common": "^11.2.3",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.2.3",
        "@nestjs/platform-express": "^11.2.3",
        "express": "^4.22.2",
        "express-openapi-validator": "^5.6.2",
        "pg": "^8.23.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.10",
        "@nestjs/cli": "^11.0.24",
        "@nestjs/schematics": "^11.1.0",
        "@redocly/cli": "^2.46.0",
        "@types/express": "^4.17.25",
        "@types/node": "^26.3.0",
        "@types/pg": "^8.23.1",
        "openapi-typescript": "^7.13.0",
        "prettier": "^3.9.6",
        "tsx": "^4.23.12",
        "typescript": "^5.9.3"
    }
}
