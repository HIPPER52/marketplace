{
    "name": "marketplace-api",
    "version": "1.0.0",
    "description": "Marketplace API - course project",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "gen:types": "openapi-typescript openapi/openapi.yaml -o src/generated/api.ts",
        "build": "npm run gen:types && tsc",
        "start": "node dist/index.js",
        "dev": "tsx watch src/index.ts",
        "typecheck": "npm run gen:types && tsc --noEmit",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "prettier --write \"**/*.{yaml,yml,md}\"",
        "format:check": "prettier --check \"**/*.{yaml,yml,md}\"",
        "lint:api": "redocly lint openapi/openapi.yaml",
        "bundle:api": "redocly bundle openapi/openapi.yaml -o spec.json",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm run lint:api",
        "prepare": "npm run build"
    },
    "author": "Dmitry Avtenev",
    "license": "ISC",
    "dependencies": {
        "express": "^4.22.2",
        "express-openapi-validator": "^5.6.2"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.10",
        "@redocly/cli": "^2.46.0",
        "@types/express": "^4.17.25",
        "@types/node": "^26.3.0",
        "openapi-typescript": "^7.13.0",
        "prettier": "^3.9.6",
        "tsx": "^4.23.12",
        "typescript": "^5.9.3"
    }
}
