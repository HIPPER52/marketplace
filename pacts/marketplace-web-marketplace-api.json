{
  "consumer": {
    "name": "marketplace-web"
  },
  "interactions": [
    {
      "description": "a request for a product that does not exist",
      "providerStates": [
        {
          "name": "no product with id 00000000-0000-4000-8000-000000000000"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/products/00000000-0000-4000-8000-000000000000"
      },
      "response": {
        "body": {
          "detail": "No product with id 00000000-0000-4000-8000-000000000000.",
          "instance": "/products/00000000-0000-4000-8000-000000000000",
          "status": 404,
          "title": "Resource not found",
          "type": "https://api.marketplace.local/problems/not-found"
        },
        "headers": {
          "Content-Type": "application/problem+json"
        },
        "matchingRules": {
          "body": {
            "$.detail": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.instance": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.title": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 404
      }
    },
    {
      "description": "a request for a product that exists",
      "providerStates": [
        {
          "name": "product 6f1c2a34-0d51-4b8e-9a7d-1f2e3c4b5a60 exists"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/products/6f1c2a34-0d51-4b8e-9a7d-1f2e3c4b5a60"
      },
      "response": {
        "body": {
          "currency": "UAH",
          "id": "6f1c2a34-0d51-4b8e-9a7d-1f2e3c4b5a60",
          "in_stock": 7,
          "price_cents": 260000,
          "title": "Mechanical keyboard"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.currency": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.in_stock": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.price_cents": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.title": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "15.0.1"
    },
    "pactRust": {
      "ffi": "0.4.28",
      "models": "1.3.5"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "marketplace-api"
  }
}