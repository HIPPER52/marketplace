# Every variable below is declared in src/config/env.schema.ts. The service refuses to
# start if a required one is missing or malformed — see README, section Configuration.
#
# Copy this file to .env and fill it in:  cp .env.example .env
# Secret VALUES here are fake on purpose. Real ones never enter git.

# Runtime mode. One of: development | test | production. Optional, defaults to development.
NODE_ENV=development

# HTTP port the service listens on. Optional, defaults to 3000.
PORT=3000

# Where the database is and which role to connect as. Required.
DATABASE_URL=postgres://marketplace_app@localhost:25432/marketplace

# Path to the file holding the database password. Optional, defaults to ./secrets/db_password.
# Created by `npm run setup:secrets`; git-ignored, and rotated by ./rotate.sh.
DB_PASSWORD_FILE=./secrets/db_password

# Maximum number of pooled Postgres connections. Optional, defaults to 10.
DB_POOL_MAX=10

# Log verbosity. One of: error | warn | log | debug | verbose. Optional, defaults to log.
LOG_LEVEL=log
