# Every variable below is declared in src/config/env.schema.ts. The service refuses to
# start if a required one is missing or malformed — see README, section Configuration.
#
# Copy this file to .env and fill it in:  cp .env.example .env
# Secret VALUES here are fake on purpose. Real ones never enter git.

# Runtime mode. One of: development | test | production. Optional, defaults to development.
NODE_ENV=development

# HTTP port the service listens on. Optional, defaults to 3000.
PORT=3000

# Where the database is and which role to connect as. Required.
# Port 26432 is PgBouncer, not Postgres: the application and every CLI script go through
# the pooler. Postgres itself is still published on 25432 for schema work and the restore
# drill, but nothing in the application points at it.
DATABASE_URL=postgres://marketplace_app@localhost:26432/marketplace

# The cache instance. Required. maxmemory + allkeys-lru: everything here may be thrown
# away at any moment, so nothing may live only here.
REDIS_URL=redis://localhost:26379

# The queue instance. Required. noeviction + AOF: BullMQ's jobs, the session state and the
# rate-limit windows, none of which anybody is allowed to evict. A separate process and not
# a separate database, because maxmemory-policy belongs to the whole instance.
REDIS_QUEUE_URL=redis://localhost:26380

# The access-token signing pair and the id that names it. Required, no defaults: a default
# here would be a signing key committed to this repository, and whoever has it can issue a
# token for anybody. PEM carried as base64 so a multi-line value survives every shell.
#   npm run keygen           # prints a ready-to-paste block
JWT_KID=dev-local
JWT_PRIVATE_KEY=base64-of-a-pkcs8-pem-see-npm-run-keygen
JWT_PUBLIC_KEY=base64-of-an-spki-pem-see-npm-run-keygen

# Keyed into every refresh-token hash, so a dump of refresh_tokens is not a dump of live
# sessions. Required, at least 16 characters.
REFRESH_TOKEN_PEPPER=a-long-random-string-for-local-development

# The object store. STORAGE_ENDPOINT is optional and is the only line that changes
# between a local emulator and real AWS S3: empty means the SDK resolves S3 from the
# region. The other three are required and have no defaults — an access key to the store
# is the right to read and write every file in it.
#   29000 is MinIO's S3 API; 29001 is its console and nothing here talks to it.
STORAGE_ENDPOINT=http://localhost:29000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=marketplace_storage
STORAGE_SECRET_KEY=local_dev_password
STORAGE_BUCKET=marketplace-files

# Path to the file holding the database password. Optional, defaults to ./secrets/db_password.
# Created by `npm run setup:secrets`; git-ignored, and rotated by ./rotate.sh.
DB_PASSWORD_FILE=./secrets/db_password

# Maximum number of pooled Postgres connections. Optional, defaults to 10.
DB_POOL_MAX=10

# Log verbosity. One of: error | warn | log | debug | verbose. Optional, defaults to log.
LOG_LEVEL=log
